<!--        To view their own record only-->
    <record id="hr_resignation_personal_rule" model="ir.rule">
            <field name="name">Employee Resignation User</field>
            <field ref="ent_hr_resignation.model_hr_resignation" name="model_id"/>
            <field name="domain_force">[('employee_id.user_id','=',user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            </record>
           
            <record id="hr_resignation_personal_rule_manager" model="ir.rule">
            <field name="name">Employee Resignation Reporting officer</field>
            <field ref="ent_hr_resignation.model_hr_resignation" name="model_id"/>
            <field name="domain_force">[]</field>
            <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
    </record>


  <record id="hr_resignation_personal_rule_Admin" model="ir.rule">
