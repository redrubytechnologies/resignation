<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <!--
            Daily cron: auto-send Relieving & Experience Letter
            to employees whose last working day (approved_revealing_date) is today.
        -->
        <record id="ir_cron_send_relieving_letter" model="ir.cron">
            <field name="name">Resignation: Send Relieving Letter on Last Working Day</field>
            <field name="model_id" ref="ent_hr_resignation.model_hr_resignation"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_relieving_letter()</field>
            <field name="active" eval="True"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="nextcall" eval="(DateTime.now()).strftime('%Y-%m-%d 06:00:00')"/>
        </record>

    </data>
</odoo>
