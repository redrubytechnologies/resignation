<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- ─────────────────────────────────────────────────────────────
             Exit Question — Form
        ───────────────────────────────────────────────────────────────── -->
        <record id="hr_exit_question_form" model="ir.ui.view">
            <field name="name">hr.exit.question.form</field>
            <field name="model">hr.exit.question</field>
            <field name="arch" type="xml">
                <form string="Exit Interview Question">
                    <sheet>
                        <group>
                            <field name="sequence"/>
                            <field name="name"/>
                            <field name="answer_type"/>
                        </group>
                        <!-- Dropdown options — shown only when type is dropdown -->
                        <notebook attrs="{'invisible': [('answer_type', '!=', 'dropdown')]}">
                            <page string="Dropdown Options">
                                <field name="option_ids">
                                    <tree editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="name"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Exit Question — Tree -->
        <record id="hr_exit_question_tree" model="ir.ui.view">
            <field name="name">hr.exit.question.tree</field>
            <field name="model">hr.exit.question</field>
            <field name="arch" type="xml">
                <tree string="Exit Interview Questions">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="answer_type"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <!-- Exit Question — Action -->
        <record id="action_hr_exit_question" model="ir.actions.act_window">
            <field name="name">Exit Interview Questions</field>
            <field name="res_model">hr.exit.question</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!-- Menu: Resignation > Exit Interview Questions -->
        <menuitem
            id="menu_hr_exit_question"
            name="Exit Interview Questions"
            parent="employee_resignation"
            action="action_hr_exit_question"
            groups="hr.group_hr_user"
            sequence="10"/>

    </data>
</odoo>
